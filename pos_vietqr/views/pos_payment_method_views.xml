<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_vietqr" model="ir.ui.view">
        <field name="name">pos.payment.method.form.vietqr</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='use_payment_terminal']" position="after">
                <field name="vietqr_bank_bin" attrs="{'invisible': [('use_payment_terminal', '!=', 'vietqr')], 'required': [('use_payment_terminal', '=', 'vietqr')]}"/>
                <field name="vietqr_account_number" attrs="{'invisible': [('use_payment_terminal', '!=', 'vietqr')], 'required': [('use_payment_terminal', '=', 'vietqr')]}"/>
                <field name="vietqr_account_name" attrs="{'invisible': [('use_payment_terminal', '!=', 'vietqr')]}"/>
                <field name="vietqr_webhook_url" widget="CopyClipboardChar" attrs="{'invisible': [('use_payment_terminal', '!=', 'vietqr')]}"/>
                <field name="vietqr_webhook_key" widget="CopyClipboardChar" attrs="{'invisible': [('use_payment_terminal', '!=', 'vietqr')]}"/>
            </xpath>
        </field>
    </record>
</odoo>
