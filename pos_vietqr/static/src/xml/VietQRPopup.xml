<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_vietqr.VietQRPopup" owl="1">
        <div class="popup popup-vietqr">
            <header class="title">VietQR</header>
            <main class="body">
                <div class="vietqr-amount" t-esc="amount"/>
                <div class="vietqr-code-wrap">
                    <img class="vietqr-code" t-att-src="qrUrl" alt="VietQR" t-att-class="{ 'is-paid': state.paid }"/>
                    <div t-if="state.paid" class="vietqr-paid"><i class="fa fa-check-circle"/> Paid</div>
                </div>
                <div class="vietqr-account">
                    <div><strong t-esc="props.request.bank_name"/> · <t t-esc="props.request.account_number"/></div>
                    <div t-if="props.request.account_name" t-esc="props.request.account_name"/>
                    <div class="vietqr-ref">Content: <strong t-esc="props.request.code"/></div>
                </div>
                <div t-if="!state.paid" class="vietqr-waiting"><i class="fa fa-circle-o-notch fa-spin"/> Waiting for the transfer…</div>
            </main>
            <footer class="footer">
                <div class="button confirm" t-att-class="{ disabled: state.paid or state.confirming }" t-on-click="confirmManually">Received (confirm manually)</div>
                <div class="button cancel" t-att-class="{ disabled: state.paid }" t-on-click="cancel">Cancel</div>
            </footer>
        </div>
    </t>
</templates>
